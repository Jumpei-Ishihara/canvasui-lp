{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },

    // 読み込むグローバル型を明示する。
    //
    // 既定では node_modules/@types 直下の全ディレクトリを型ライブラリとして
    // 自動で読み込むため、そこに壊れたエントリ（同期ツールが作る "node 2" の
    // ような複製など）が 1 つでもあると、無関係な TS2688 でビルド全体が落ちる。
    // 実際にこの環境で 2 度発生した。
    //
    // 明示すれば自動走査をやめられ、環境の汚れに影響されなくなる。
    // モジュールとして import する型（@types/three 等）はここに書く必要はない。
    "types": ["node", "vite/client"]
  },
  "include": ["src", "scripts"]
}
